# .env.example — documents every env var Hermes reads; holds NO real values.
# Copy to .env (git-ignored) and fill in. NEVER commit .env.
# In code, read these via os.getenv("NAME") / os.environ["NAME"] — never hardcode.

# ─── LLM / search ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here    # Claude Haiku (signals) + Sonnet (clusters/digest)
TAVILY_API_KEY=tvly-your-key-here               # Tavily AI news search

# ─── Upstash Redis (exact lookup) ─────────────────────────
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ─── Upstash Vector (semantic RAG for /search) ────────────
UPSTASH_VECTOR_REST_URL=https://your-index.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your_upstash_vector_token

# ─── Supabase sink (signal mirror) ────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Zeus notifier (outbound webhook on significant signals) ─
ZEUS_WEBHOOK_URL=https://your-zeus-webhook-url
ZEUS_API_KEY=your_zeus_api_key

# ─── API auth ─────────────────────────────────────────────
HERMES_API_KEY=your_secret_key_shared_with_consumers   # X-API-Key on all endpoints
