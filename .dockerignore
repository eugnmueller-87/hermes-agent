# Keep secrets and local cruft OUT of the published image.
# Without this, `COPY . .` bakes the live .env (Anthropic/Tavily/Upstash/Miro keys)
# and the full .git history into the GHCR image.
.env
.env.*
!.env.example
.git
.gitignore
.github

# Python / local
.venv
venv
__pycache__
*.pyc
.ruff_cache
.pytest_cache
*.egg-info

# Notebooks, logs, local data
*.ipynb
.ipynb_checkpoints
logs
audit_logs
*.log

# Backups + dev-only docs (not needed at runtime)
*_backup.py
main_full_backup.py
main_ai_focus.py
config/suppliers_full_backup.py
